	partition fct_sale_line = m
		mode: import
		source =
				let
				    Source = marts{[Name = "FCT_SALE_LINES", Kind = "Table"]}[Data],
				    Completed = Table.SelectRows(Source, each [IS_CANCELLED] = false),
				    Kept = Table.SelectColumns(Completed, {"SALE_LINE_ID", "SALE_ID", "SALE_DATE", "STORE_ID", "PRODUCT_ID", "PERSON_ID", "COUPON_CAMPAIGN_ID", "CHANNEL", "QUANTITY", "GROSS_AMOUNT", "DISCOUNT_AMOUNT", "NET_AMOUNT", "COST_AMOUNT", "GROSS_MARGIN"}),
				    Lower = Table.TransformColumnNames(Kept, Text.Lower),
				    Keys = Table.ReplaceValue(Lower, null, -1, Replacer.ReplaceValue, {"person_id", "coupon_campaign_id"}),
				    Channel = Table.TransformColumns(Keys, {{"channel", each if _ = "in_store" then "In Store" else "Online", type text}})
				in
				    Channel

