              "nativeQueryRef": "Emails Sent",
              "displayName": "Sent"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_email_event"
                    }
                  },
                  "Property": "Emails Opened"
                }
              },
              "queryRef": "fct_email_event.Emails Opened",
              "nativeQueryRef": "Emails Opened",
              "displayName": "Opened"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fct_email_event"
                    }
