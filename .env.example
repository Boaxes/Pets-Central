# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# True behind HTTPS (Azure): secure cookies, and the hosts above become trusted origins for forms.
DJANGO_HTTPS=False

POSTGRES_DB=pets_central
POSTGRES_USER=pets_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use "require" on Azure Database for PostgreSQL Flexible Server.
POSTGRES_SSLMODE=prefer

# The Store Assistant's read-only database login, created by scripts/setup_local_db.ps1.
ASSISTANT_DB_USER=pets_assistant
ASSISTANT_DB_PASSWORD=change-me
# Claude answers the Store Assistant's questions. Policy search also needs a Voyage AI key and the pgvector extension.
ANTHROPIC_API_KEY=
# Policy search's embedding model (Azure OpenAI, signed in with the app's managed identity). Blank locally.
AZURE_OPENAI_ENDPOINT=

# Snowflake: the loaders and dbt each sign in as their own service user with a key pair (see infra/snowflake/).
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=PETS_LOADER_SVC
SNOWFLAKE_ROLE=PETS_LOADER
SNOWFLAKE_WAREHOUSE=PETS_WH
SNOWFLAKE_DATABASE=PETS_CENTRAL_DEV
SNOWFLAKE_PRIVATE_KEY_PATH=path/to/pets_loader.p8
SNOWFLAKE_DBT_USER=PETS_DBT_SVC
SNOWFLAKE_DBT_ROLE=PETS_TRANSFORMER
SNOWFLAKE_DBT_PRIVATE_KEY_PATH=path/to/pets_dbt.p8

# The loyalty platform's API, for the loyalty loader.
LOYALTY_API_URL=http://127.0.0.1:8001
LOYALTY_API_KEY=change-me

# Lets anyone sign in as a store manager without a password (demos and screenshots only).
DJANGO_DEMO_SIGN_IN=False
DJANGO_DEMO_PASSWORD=change-me

# Which generated dataset dbt reads its truth files from (data/generated/<size>/): small locally, full in production.
PETS_DATA_SIZE=small
